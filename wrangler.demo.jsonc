// Public read-only demo with the fictional house. No storage, no secrets.
{
  "name": "house-twin-demo",
  "main": "server/worker.js",
  "compatibility_date": "2026-10-15",
  "workers_dev": true,
  "assets": { "directory": "./web", "binding": "ASSETS", "run_worker_first": ["/api/*"], "not_found_handling": "single-page-application" },
  "vars": { "DEMO": "1", "AI_MODEL": "google/gemini-2.5-flash" },
  "observability": { "enabled": false }
}
