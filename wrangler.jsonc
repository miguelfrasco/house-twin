// Your own house on Cloudflare Workers (free plan). See README "Deploy on Cloudflare".
// 1. npx wrangler@4 kv namespace create TWIN   -> paste the id below
// 2. npx wrangler@4 secret put SETUP_CODE      -> any long random string, used once in the wizard
// 3. npm run cf:deploy
{
  "name": "house-twin",
  "main": "server/worker.js",
  "compatibility_date": "2026-10-15",
  "assets": { "directory": "./web", "binding": "ASSETS", "run_worker_first": ["/api/*"], "not_found_handling": "single-page-application" },
  "kv_namespaces": [{ "binding": "TWIN", "id": "REPLACE_WITH_YOUR_KV_NAMESPACE_ID" }],
  "vars": { "AI_MODEL": "google/gemini-2.5-flash" },
  "observability": { "enabled": false }
}
